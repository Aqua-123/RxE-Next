{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!dist", "!lint/fixtures"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "includes": ["**", "!**/*.md"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": [
    {
      "path": "./lint/no-inline-style.grit",
      "includes": ["src/**"]
    },
    {
      "path": "./lint/no-color-literals.grit",
      "includes": ["src/**/*.ts", "src/**/*.tsx", "!src/site/tokens.ts", "!src/themes/builtin/**"]
    },
    {
      "path": "./lint/no-css-color-literals.grit",
      "includes": ["src/**/*.css", "!src/ui/styles/tokens.css"]
    },
    {
      "path": "./lint/portal-into-shadow-root.grit",
      "includes": ["src/**/*.tsx"]
    }
  ],
  "overrides": [
    {
      "includes": ["src/site/surfaces/**", "src/features/**", "test/webpack.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noUselessEscapeInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["src/ui/components/ui/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          },
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
